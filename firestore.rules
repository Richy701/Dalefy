rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: check if the caller is an admin/owner of a given org ────────
    function isOrgAdmin(orgId) {
      let mem = get(/databases/$(database)/documents/org_members/$(request.auth.uid + '_' + orgId));
      return mem != null && mem.data.role in ["owner", "admin"];
    }

    function isOrgMember(orgId) {
      return exists(/databases/$(database)/documents/org_members/$(request.auth.uid + '_' + orgId));
    }

    function isOrgEditor(orgId) {
      let mem = get(/databases/$(database)/documents/org_members/$(request.auth.uid + '_' + orgId));
      return mem != null && mem.data.role in ["owner", "admin", "agent"];
    }

    // ── System cron user (flight status checker) ──────────────────────────
    function isCronUser() {
      return request.auth != null
             && request.auth.token.email == "cron@dalefy.app";
    }

    // ── Helper: check if the caller is a trip member (by auth UID) ──────
    function isTripMember(tripId) {
      return exists(/databases/$(database)/documents/trip_members/$(request.auth.uid + '_' + tripId));
    }

    // ── Helper: a trip is joinable if it is published, or the caller owns
    //    it / is an org editor of it (so joins can't be minted on private trips)
    function canJoinTrip(tripId) {
      let t = get(/databases/$(database)/documents/trips/$(tripId));
      return t != null && (
        t.data.status in ["Published", "published"]
        || t.data.user_id == request.auth.uid
        || (t.data.organization_id != null && isOrgEditor(t.data.organization_id))
      );
    }

    // ── Profiles: any authenticated user can read; only owner can write ──
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── App config (allowlists etc.) — console-managed, read-only to clients ──
    match /app_config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    function canCreateOrg() {
      return get(/databases/$(database)/documents/app_config/org_creators).data[request.auth.uid] == true;
    }

    // ── Organizations ──────────────────────────────────────────────────────
    match /organizations/{orgId} {
      // Any authenticated user can read (needed for agency code uniqueness checks)
      allow read: if request.auth != null;
      // Internal tool: only allowlisted users (app_config/org_creators) can create agencies
      allow create: if request.auth != null
                    && request.resource.data.created_by == request.auth.uid
                    && canCreateOrg();
      // Only admins/owners can update or delete
      allow update, delete: if request.auth != null && isOrgAdmin(orgId);
    }

    // ── Org members ────────────────────────────────────────────────────────
    function isOrgOwner(orgId) {
      let mem = get(/databases/$(database)/documents/org_members/$(request.auth.uid + '_' + orgId));
      return mem != null && mem.data.role == "owner";
    }

    function inviteFor(token) {
      return get(/databases/$(database)/documents/org_invites/$(token)).data;
    }

    match /org_members/{docId} {
      // A user can read their own memberships; org members can read their org's roster
      allow read: if request.auth != null
        && (resource.data.user_id == request.auth.uid
            || isOrgMember(resource.data.organization_id));

      // Doc ID must always be `${user_id}_${organization_id}` so the helper lookups work
      allow create: if request.auth != null
        && request.resource.data.user_id is string
        && request.resource.data.organization_id is string
        && docId == request.resource.data.user_id + '_' + request.resource.data.organization_id
        && (
          // Bootstrap: the user is creating their own owner membership AND they created the org
          (request.resource.data.user_id == request.auth.uid
           && request.resource.data.role == "owner"
           && get(/databases/$(database)/documents/organizations/$(request.resource.data.organization_id)).data.created_by == request.auth.uid)
          ||
          // Existing admin/owner is adding a non-owner member
          (request.resource.data.role in ["admin", "agent", "viewer"]
           && isOrgAdmin(request.resource.data.organization_id))
          ||
          // Accepting an invite: user adds themselves with the invited role, from a
          // pending, unexpired invite addressed to their verified email
          (request.resource.data.user_id == request.auth.uid
           && request.auth.token.email_verified == true
           && request.resource.data.invite_token is string
           && inviteFor(request.resource.data.invite_token).status == "pending"
           && inviteFor(request.resource.data.invite_token).email.lower() == request.auth.token.email.lower()
           && inviteFor(request.resource.data.invite_token).organization_id == request.resource.data.organization_id
           && inviteFor(request.resource.data.invite_token).role == request.resource.data.role
           && request.resource.data.role in ["admin", "agent", "viewer"]
           && inviteFor(request.resource.data.invite_token).expires_at_ms is number
           && inviteFor(request.resource.data.invite_token).expires_at_ms > request.time.toMillis())
        );

      // Only the role may change. Admins can set admin/agent/viewer on other non-owners;
      // only the owner can grant owner, change an owner's role, or change their own role.
      allow update: if request.auth != null
        && isOrgAdmin(resource.data.organization_id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role"])
        && request.resource.data.role in ["owner", "admin", "agent", "viewer"]
        && (request.resource.data.role != "owner" || isOrgOwner(resource.data.organization_id))
        && (resource.data.role != "owner" || isOrgOwner(resource.data.organization_id))
        && (resource.data.user_id != request.auth.uid || isOrgOwner(resource.data.organization_id));

      // Users can leave (unless they are the owner); admins can remove non-owners
      allow delete: if request.auth != null
        && resource.data.role != "owner"
        && (resource.data.user_id == request.auth.uid
            || isOrgAdmin(resource.data.organization_id));
    }

    // ── Org invites ─────────────────────────────────────────────────────────
    match /org_invites/{inviteId} {
      // Org admins see their org's invites; an invitee can read the invite addressed to them
      allow read: if request.auth != null
                  && (isOrgAdmin(resource.data.organization_id)
                      || isCronUser()
                      || (request.auth.token.email != null
                          && resource.data.email.lower() == request.auth.token.email.lower()));
      // Only org admins/owners can create invites
      allow create: if request.auth != null
                    && request.resource.data.organization_id is string
                    && request.resource.data.status == "pending"
                    && request.resource.data.role in ["admin", "agent", "viewer"]
                    && isOrgAdmin(request.resource.data.organization_id);
      // Admins can revoke; the invitee can only flip a pending invite to accepted
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "accepted_at"])
                    && (
                      (isOrgAdmin(resource.data.organization_id)
                       && request.resource.data.status in ["pending", "revoked"])
                      ||
                      (resource.data.status == "pending"
                       && request.resource.data.status == "accepted"
                       && request.auth.token.email != null
                       && resource.data.email.lower() == request.auth.token.email.lower())
                    );
      allow delete: if request.auth != null
                    && isOrgAdmin(resource.data.organization_id);
    }

    // ── Org branding ───────────────────────────────────────────────────────
    match /org_branding/{orgId} {
      // Anyone can read (needed for shared/public trip pages)
      allow read: if true;
      // Only org admins/owners can write
      allow write: if request.auth != null && isOrgAdmin(orgId);
    }

    // ── Trips ──────────────────────────────────────────────────────────────
    match /trips/{tripId} {
      // Published trips are readable by anyone (shared links, PIN join flow).
      // Non-published trips require ownership, org membership, or cron. Trip
      // membership is NOT a read grant here: since it is world-mintable, it
      // would otherwise let anyone read private/draft trips.
      allow read: if resource.data.status in ["Published", "published"]
                  || (request.auth != null
                      && (resource.data.user_id == request.auth.uid
                          || isCronUser()
                          || (resource.data.organization_id != null
                              && isOrgMember(resource.data.organization_id))));

      // Only authenticated users can create; user_id must match caller
      allow create: if request.auth != null
                    && request.resource.data.user_id == request.auth.uid;

      // The creator, org editor (not viewer), or cron user can update. A trip
      // member can update only while the trip is published (travelers claim a
      // slot / attach media on published trips); this stops a stale or
      // self-minted membership from editing a private/draft trip.
      allow update: if request.auth != null
                    && (resource.data.user_id == request.auth.uid
                        || isCronUser()
                        || (isTripMember(tripId)
                            && resource.data.status in ["Published", "published"])
                        || (resource.data.organization_id != null
                            && isOrgEditor(resource.data.organization_id)));
      allow delete: if request.auth != null
                    && (resource.data.user_id == request.auth.uid
                        || isCronUser()
                        || (resource.data.organization_id != null
                            && isOrgAdmin(resource.data.organization_id)));
    }

    // ── Trip members ───────────────────────────────────────────────────────
    match /trip_members/{docId} {
      // Read: authenticated users only
      allow read: if request.auth != null;

      // Create: must be authenticated, include a trip_id, identify via
      // device_id or a matching uid/user_id, AND the target trip must be
      // joinable (published, or owned / org-edited by the caller). Without the
      // joinable check, any user could mint membership on any trip.
      allow create: if request.auth != null
                    && request.resource.data.trip_id is string
                    && request.resource.data.trip_id.size() > 0
                    && (request.resource.data.device_id is string
                        || request.resource.data.uid == request.auth.uid
                        || request.resource.data.user_id == request.auth.uid)
                    && canJoinTrip(request.resource.data.trip_id);

      // The member themselves, the trip owner, or an org editor can update/delete.
      allow update, delete: if request.auth != null
        && (resource.data.user_id == request.auth.uid
            || resource.data.uid == request.auth.uid
            || resource.data.device_id == request.auth.uid
            || exists(/databases/$(database)/documents/trip_members/$(request.auth.uid + '_' + resource.data.trip_id))
            || (exists(/databases/$(database)/documents/trips/$(resource.data.trip_id))
                && get(/databases/$(database)/documents/trips/$(resource.data.trip_id)).data.user_id == request.auth.uid)
            || (resource.data.organization_id != null
                && isOrgEditor(resource.data.organization_id))
            || (exists(/databases/$(database)/documents/trips/$(resource.data.trip_id))
                && get(/databases/$(database)/documents/trips/$(resource.data.trip_id)).data.organization_id != null
                && isOrgEditor(get(/databases/$(database)/documents/trips/$(resource.data.trip_id)).data.organization_id))
            // Fallback: org admin via user profile (handles orphaned trip_members whose trip was deleted)
            || (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.current_org_id != null
                && isOrgAdmin(get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.current_org_id)));
    }

    // ── Trip presence: real-time editing presence ────────────────────────
    match /trip_presence/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.resource.data.user_id == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.user_id == request.auth.uid;
    }

    // ── Push tokens: scoped to owning user (cron can read all for notifications)
    match /push_tokens/{docId} {
      allow read: if request.auth != null
                  && (resource.data.user_id == request.auth.uid || isCronUser());
      allow create, update: if request.auth != null
                            && request.resource.data.user_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }
  }
}
