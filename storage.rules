rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function orgRole(orgId, roles) {
      return request.auth != null && orgId != null
        && firestore.get(/databases/(default)/documents/org_members/$(request.auth.uid + '_' + orgId)).data.role in roles;
    }

    // A private trip's files belong to its creator alone, matching the Firestore rules
    function sharedOrMine(trip) {
      return trip.get('private', false) != true || trip.user_id == request.auth.uid;
    }

    function tripEditor(tripId) {
      let trip = firestore.get(/databases/(default)/documents/trips/$(tripId)).data;
      return request.auth != null && (trip.user_id == request.auth.uid
        || (orgRole(trip.get('organization_id', null), ['owner', 'admin', 'agent']) && sharedOrMine(trip)));
    }

    function tripStaff(tripId) {
      let trip = firestore.get(/databases/(default)/documents/trips/$(tripId)).data;
      return request.auth != null && (trip.user_id == request.auth.uid
        || (orgRole(trip.get('organization_id', null), ['owner', 'admin', 'agent', 'viewer']) && sharedOrMine(trip)));
    }

    function tripMember(tripId) {
      let trip = firestore.get(/databases/(default)/documents/trips/$(tripId)).data;
      let member = firestore.get(/databases/(default)/documents/trip_members/$(request.auth.uid + '_' + tripId)).data;
      return request.auth != null && trip.status in ['Published', 'published']
        && member.uid == request.auth.uid && member.trip_id == tripId;
    }

    // Avatar uploads: scoped by auth UID, max 2MB, images only
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    // Logo uploads: namespaced by org ID, then by uploading user's UID.
    // Organization administration is checked against Firestore.
    match /logos/{orgId}/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }
    // Legacy flat path (read-only for existing logos)
    match /logos/{orgId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Gallery reads/uploads require membership; editors may moderate any upload.
    match /trips/{tripId}/media/{uid}/{fileName} {
      // The app marks new uploads by filename so each request follows one access
      // route, staying within Storage's two-document Firestore lookup limit.
      // Existing organiser filenames and download URLs remain compatible.
      allow read: if request.auth != null && (fileName.matches('member_.*')
        ? tripMember(tripId) : tripStaff(tripId) || tripMember(tripId));
      allow create, update: if request.auth != null && request.auth.uid == uid
        && (fileName.matches('member_.*') ? tripMember(tripId) : tripEditor(tripId) || tripMember(tripId))
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
      allow delete: if request.auth != null && (fileName.matches('member_.*')
        ? (request.auth.uid == uid ? tripMember(tripId) : tripEditor(tripId))
        : tripEditor(tripId) || (request.auth.uid == uid && tripMember(tripId)));
    }
    match /trips/{tripId}/media/{fileName} {
      allow read: if tripStaff(tripId) || tripMember(tripId);
      allow delete: if tripEditor(tripId);
    }

    // Published readers receive only approved download capabilities from the API.
    // They cannot enumerate private files or fetch metadata for hidden attachments.
    match /trips/{tripId}/events/{allPaths=**} {
      allow read: if tripStaff(tripId);
      allow create, update: if tripEditor(tripId)
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
      allow delete: if tripEditor(tripId);
    }
    match /trips/{tripId}/{fileName} {
      allow read: if tripStaff(tripId);
      allow create, update: if tripEditor(tripId)
        && request.resource.size < 50 * 1024 * 1024;
      allow delete: if tripEditor(tripId);
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
